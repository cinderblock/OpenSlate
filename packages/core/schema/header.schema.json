{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cinderblock/openslate/master/packages/core/schema/header.schema.json",
  "title": "OpenSlate JWS Header",
  "$ref": "#/definitions/JwsHeader",
  "definitions": {
    "JwsHeader": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "EdDSA"
        },
        "typ": {
          "type": "string",
          "const": "openslate+jws"
        },
        "kid": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "alg",
        "typ",
        "kid"
      ],
      "additionalProperties": false
    }
  }
}
