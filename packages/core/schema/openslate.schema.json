{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/cinderblock/openslate/master/packages/core/schema/openslate.schema.json",
  "title": "OpenSlate v1",
  "description": "An OpenSlate token is a JWS-compact (RFC 7515) string: BASE64URL(JCS(header)) + '.' + BASE64URL(JCS(payload)) + '.' + BASE64URL(signature). The 'header' conforms to #/definitions/JwsHeader, the 'payload' to #/definitions/SlatePayload. See SPEC.md and vectors/ for the normative format and conformance test vectors.",
  "$ref": "#/definitions/SlatePayload",
  "definitions": {
    "SlatePayload": {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "issuer": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "uri": {
              "type": "string",
              "format": "uri",
              "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "context": {
          "type": "object",
          "properties": {
            "election": {
              "type": "string",
              "minLength": 1
            },
            "jurisdiction": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "jurisdiction": {
                    "type": "string",
                    "minLength": 1
                  },
                  "district": {
                    "type": "string",
                    "minLength": 1
                  },
                  "election": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uri": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
                  },
                  "ballot": {
                    "type": "object",
