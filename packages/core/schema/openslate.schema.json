                      "minLength": 1
                    },
                    "election": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uri": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
