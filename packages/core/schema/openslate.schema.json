            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
              }
            }
          },
          "required": [
            "of",
            "mode",
            "retrieved_at"
          ],
          "additionalProperties": false
        },
        "adopts": {
          "type": "array",
