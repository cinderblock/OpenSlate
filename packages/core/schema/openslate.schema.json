              "ballot": {
                "type": "object",
                "properties": {
                  "party": {
                    "type": "string",
                    "minLength": 1
                  },
                  "designation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "incumbent": {
                    "type": "boolean",
                    "const": true
                  }
