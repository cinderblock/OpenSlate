                        "type": "string",
                        "minLength": 1
                      },
                      "number": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "measure_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "vote_for": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "ranks": {
                        "type": "integer",
                        "minimum": 2
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1,
                    "not": {
                      "required": [
                        "vote_for",
                        "ranks"
                      ]
                    }
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              },
              "stance": {
                "type": "string",
