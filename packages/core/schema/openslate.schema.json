                "type": "string"
              },
              "slate": {
                "type": "string"
              },
              "uri": {
                "type": "string",
                "format": "uri",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
              },
              "note": {
                "type": "string"
