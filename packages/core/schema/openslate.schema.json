              ]
            }
          }
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "v",
        "issuer",
        "issued_at",
        "positions"
      ],
      "additionalProperties": false
    },
    "JwsHeader": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "EdDSA"
        },
        "typ": {
          "type": "string",
          "const": "openslate+jws"
        },
        "kid": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "alg",
        "typ",
        "kid"
      ],
      "additionalProperties": false
    }
  }
