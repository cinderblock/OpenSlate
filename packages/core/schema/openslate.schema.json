                    "ballot": {
                      "type": "object",
                      "properties": {
                        "heading": {
                          "type": "string",
                          "minLength": 1
                        },
                        "number": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "measure_type": {
                          "type": "string",
                          "minLength": 1
                        },
                        "vote_for": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "ranks": {
                          "type": "integer",
                          "minimum": 2
                        }
                      },
                      "additionalProperties": false,
                      "minProperties": 1,
                      "not": {
                        "required": [
                          "vote_for",
                          "ranks"
                        ]
                      }
                    }
                  },
                  "required": [
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "source": {
                "type": "string",
                "format": "uri",
                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "issuer"
            ],
            "additionalProperties": false
          }
        },
        "articles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "jurisdiction": {
                    "type": "string",
                    "minLength": 1
                  },
                  "district": {
                    "type": "string",
                    "minLength": 1
                  },
                  "election": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uri": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:"
                  },
                  "ballot": {
                    "type": "object",
                    "properties": {
                      "heading": {
                        "type": "string",
                        "minLength": 1
                      },
                      "number": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "measure_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "vote_for": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "ranks": {
                        "type": "integer",
                        "minimum": 2
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1,
                    "not": {
