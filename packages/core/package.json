{
  "name": "@openslate/core",
  "version": "0.0.0",
  "type": "module",
  "description": "OpenSlate reference implementation: types, canonical JSON, Ed25519 signing & verification.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./civic": "./src/civic.ts",
    "./countyReport": "./src/countyReport.ts",
    "./contestOffice": "./src/contestOffice.ts",
    "./countyResults": "./src/countyResults.ts",
    "./districts": "./src/districts.ts",
    "./stateResults": "./src/stateResults.ts",
    "./liveRecord": "./src/liveRecord.ts",
    "./names": "./src/names.ts",
    "./raceHistory": "./src/raceHistory.ts",
    "./recordSchedule": "./src/recordSchedule.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "schema"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "schema": "bun run scripts/export-schema.ts",
    "vectors:generate": "bun run scripts/vectors-generate.ts",
    "vectors:check": "bun run scripts/vectors-check.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.7.0",
    "@scure/base": "^1.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "zod-to-json-schema": "^3.24.1"
  }
}
