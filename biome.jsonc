{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // styles.css is ordered by section, so base element rules (`button`) follow
      // component rules with more specificity; specificity picks the right one.
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "auto"
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all" }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/build",
      "!**/node_modules",
      // Prose is hand-wrapped; the Markdown formatter would reflow every table.
      "!**/*.md",
      "!**/*.gen.ts",
      "!packages/core/schema/*.json",
      "!vectors/positive/*.json",
      "!vectors/negative/*.json",
      "!vectors/keys.json",
      "!apps/web/public/geo/*.json",
      // Captured evidence: formatting one byte would break its proofs.
      "!experiments/signed-source-capture/results"
    ]
  }
}
