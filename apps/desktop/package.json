{
  "name": "@openslate/desktop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "OpenSlate desktop app (Electrobun): the web app in a native window, with or without a built-in copy of the public catalog.",
  "license": "MIT",
  "scripts": {
    "dev": "bun scripts/build.ts --dev",
    "build": "bun scripts/build.ts",
    "icons": "bun scripts/icons.ts",
    "typecheck": "electrobun prepare && tsc --noEmit -p .",
    "selftest": "bun scripts/selftest.ts"
  },
  "dependencies": {
    "@openslate/core": "workspace:*"
  },
  "devDependencies": {
    "electrobun": "2.0.4"
  }
}
