# Build settings for the hosted app at https://openslate.us (`vite build`).
# Everything here ends up in the public bundle; nothing secret belongs here.

# Polls, results and the Census and Google relays: the project's worker.
# (No Kalshi forecasts: those are a self-hosted opt-in, see the README.)
VITE_API_BASE=https://api.openslate.us
VITE_RESULTS_BASE=https://api.openslate.us/api/results/v2

# Usage statistics (opt-in) and private feedback go to our telemetry-collector.
# Its ingest key isn't here: the build derives it from the app secret
# (vite.config.ts), so a fork's build doesn't report to this collector.
VITE_TELEMETRY_ENDPOINT=https://telemetry.tomsawyerlabs.com
