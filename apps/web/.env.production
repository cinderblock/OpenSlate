# Build settings for the hosted app at https://openslate.us (`vite build`).
# Everything here ends up in the public bundle; nothing secret belongs here.

# Polls, results and forecasts go through the project's cache worker.
VITE_POLLS_BASE=https://polls.openslate.us
VITE_RESULTS_BASE=https://polls.openslate.us/api/results/v2
VITE_FORECASTS_BASE=https://polls.openslate.us/api/forecasts/v2

# Cloudflare Web Analytics site for openslate.us, created by ops
# (`bun run web-analytics` there prints it). The beacon loads only while the
# user's "Share anonymous usage statistics" switch is on (src/lib/usage.ts).
VITE_CF_BEACON_TOKEN=2b3f91845a854656ab9fac599dcdbeb5
