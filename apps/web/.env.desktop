# Build settings for the desktop app (`vite build --mode desktop`, run by
# apps/desktop). Like .env.production, everything here ends up in the bundle.

# Polls, results, forecasts and the Census and Google relays: the project's worker.
VITE_POLLS_BASE=https://api.openslate.us
VITE_RESULTS_BASE=https://api.openslate.us/api/results/v2
VITE_FORECASTS_BASE=https://api.openslate.us/api/forecasts/v2

# Usage statistics (opt-in) and private feedback go to our telemetry-collector.
VITE_TELEMETRY_ENDPOINT=https://telemetry.tomsawyerlabs.com

# The offline flavor also sets VITE_PUBLIC_ENDORSEMENTS_CATALOG=catalog/index.json
# (apps/desktop/scripts/stage.ts), pointing at the snapshot it ships beside the app.
