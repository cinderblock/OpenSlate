# Port the server listens on (default 8787)
PORT=8787

# OPTIONAL, self-host only. The default OpenSlate app is fully client-side and does
# not need this server. Setting a key enables GET /api/ballot, which proxies the
# Google Civic Information API (voterInfoQuery) for ballot lookups. The address is
# forwarded upstream and never stored or logged.
#
# This is a Google Cloud API key (enable "Civic Information API" in Google Cloud
# Console, then create an API key). It is NOT the Voting Information Tool customizer
# (that's a separate client-side widget). Without a key, /api/ballot returns 501 and
# the apps fall back to manual subject entry.
GOOGLE_API_KEY=
# Override the upstream base URL if needed.
# GOOGLE_API_BASE=https://www.googleapis.com/civicinfo/v2
