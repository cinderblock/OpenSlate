# Port the server listens on (default 8787)
PORT=8787

# OPTIONAL, self-host only. The default OpenSlate app is fully client-side and does
# not need this server. Setting a key enables GET /api/civic/elections and
# POST /api/civic/voterinfo, which ask the Google Civic Information API for the
# elections list and an address's ballot. The address is forwarded upstream and
# never stored or logged. (People can also use their own key straight from the
# browser, without this server: Settings → "Your Google API key".)
#
# This is a Google Cloud API key (enable "Civic Information API" in Google Cloud
# Console, then create an API key restricted to that API). It is NOT the Voting
# Information Tool customizer (that's a separate client-side widget). Without a key,
# those routes return 501 and the app doesn't offer them.
GOOGLE_API_KEY=
# Override the upstream base URL if needed.
# GOOGLE_API_BASE=https://civicinfo.googleapis.com/civicinfo/v2
# Other origins whose pages may call the civic routes (comma-separated). Same-origin
# pages and localhost always can.
# CIVIC_ALLOWED_ORIGINS=https://openslate.example
