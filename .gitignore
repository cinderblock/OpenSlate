# dependencies
node_modules/

# build output
dist/
build/
.vite/
packages/*/dist/
apps/*/dist/
# wrangler dev state
.wrangler/

# electrobun
.electrobun/
apps/desktop/build/
apps/desktop/dist/

# test / coverage
coverage/

# env & secrets
.env
.env.*
!.env.example
# The hosted app's public build settings (no secrets; they ship in the bundle).
!apps/web/.env.production
!apps/web/.env.desktop

# private keys / generated identities (contain Ed25519 secret keys)
*.identity.json
*.key

# logs & os cruft
*.log
.DS_Store
Thumbs.db

# catalog snapshot for offline builds (apps/web/scripts/snapshot-catalog.ts)
apps/web/snapshot/
